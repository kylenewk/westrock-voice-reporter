ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
PORT=3001

# Option 1: Single-user PAT token (existing behavior)
HUBSPOT_ACCESS_TOKEN=pat-na1-...
HUBSPOT_OWNER_ID=211824246
HUBSPOT_PORTAL_ID=4936417

# Option 2: Multi-user OAuth (set these INSTEAD of ACCESS_TOKEN for per-user login)
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_REDIRECT_URI=https://your-server.com/api/auth/hubspot/callback
HUBSPOT_SCOPES=crm.objects.deals.read crm.objects.deals.write crm.objects.contacts.read crm.objects.companies.read
MOBILE_REDIRECT_URI=westrock-reporter://auth/callback

# Optional: set for production to use Redis sessions (omit for in-memory)
REDIS_URL=redis://...
