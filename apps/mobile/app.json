{
  "expo": {
    "name": "WestRock Voice Reporter",
    "slug": "westrock-voice-reporter",
    "version": "1.0.0",
    "runtimeVersion": "1.0.0",
    "orientation": "portrait",
    "scheme": "westrock-reporter",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#2d1b69"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.westrockcoffee.voicereporter",
      "buildNumber": "16",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Voice Reporter uses speech recognition to transcribe your call reports.",
        "NSMicrophoneUsageDescription": "Voice Reporter needs microphone access to listen to your verbal reports.",
        "NSPhotoLibraryUsageDescription": "Voice Reporter may access your photo library to attach images to reports.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2d1b69"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.westrockcoffee.voicereporter"
    },
    "plugins": [
      "expo-router",
      "./plugins/fix-folly-coroutines"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ce278abb-6909-463b-8ff9-b19662a2fe46"
      }
    },
    "owner": "kylenewk"
  }
}
